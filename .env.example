# ==============================================================================
# Configuration du simulateur OSCAR
# ==============================================================================
# Ce fichier est un exemple. Copiez-le en ".env" et remplissez vos valeurs.
# Vous pouvez aussi entrer ces valeurs directement dans le menu interactif
# au lancement de main.py.
#
# Usage :
#   cp .env.example .env
#   # Editez .env avec vos valeurs
#   python main.py
# ==============================================================================

# URL du serveur LiveKit (avec wss:// pour la production, ws:// pour le local)
LIVEKIT_URL=wss://stream-livekit.oscar-bot.com

# Cles API au format cle:secret
LIVEKIT_KEYS=votre_cle_api:votre_secret_api

# Nom de la room LiveKit
DEFAULT_ROOM_NAME=oscar-lot1-room

# Index de la camera (0 = premiere camera du systeme)
CAMERA_INDEX=0

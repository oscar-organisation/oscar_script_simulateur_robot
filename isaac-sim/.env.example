# Connection to the OSCAR LiveKit deployment.
# Room + identity now follow the per-robot session scheme (2026-07-22):
#   OSCAR_LIVEKIT_URL / OSCAR_LIVEKIT_ROOM / OSCAR_ROBOT_IDENTITY / OSCAR_LIVEKIT_TOKEN
LIVEKIT_URL=wss://stream-livekit.oscar-bot.com
LIVEKIT_ROOM=oscar-oscar-02-d97da823

# Server-side only — never expose in the browser.
# Used by media_agent.py when LIVEKIT_TOKEN is not set, to mint a publisher JWT
# locally instead of running `npm run livekit:tokens` first.
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# If set, takes precedence over API_KEY/API_SECRET signing.
# LIVEKIT_TOKEN=

# Identity the front uses to pick the active publisher. The front prioritises
# `simulateur-robot-*` over generic `robot-*` (src/capture/livekitStream.js:73).
LIVEKIT_PUBLISHER_IDENTITY=robot-oscar-02

# Command agent: subscribes to XR joystick packets and moves the robot in Isaac.
LIVEKIT_COMMAND_IDENTITY=isaac-command-agent
# Prefer a command-scoped token generated by `npm run livekit:tokens`.
# LIVEKIT_COMMAND_TOKEN=
LIVEKIT_XR_INPUT_TOPIC=oscar.xr.input
LIVEKIT_COMMAND_TOPIC=oscar.robot.command
TELEOP_APPLY=log
TELEOP_ROBOT_PRIM=/World/g1
TELEOP_WATCHDOG_MS=300
TELEOP_CONTROL_HZ=30

# Default video parameters. Override with CLI flags.
PUBLISHER_TRACK_NAME=camera-360
PUBLISHER_PROJECTION=equirect
PUBLISHER_WIDTH=3840
PUBLISHER_HEIGHT=1920
PUBLISHER_FPS=30
